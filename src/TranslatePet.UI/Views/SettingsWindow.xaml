<Window x:Class="TranslatePet.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠翻译 - 偏好设置" 
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseDown="OnWindowMouseDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171822"/>
            <Setter Property="Foreground" Value="#E0E2EC"/>
            <Setter Property="BorderBrush" Value="#2D2F3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#171822"/>
            <Setter Property="Foreground" Value="#E0E2EC"/>
            <Setter Property="BorderBrush" Value="#2D2F3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A4B8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E2EC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1F202C" CornerRadius="12" BorderBrush="#353748" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="⚙️ 软件设置" Foreground="#00E5FF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                <Button Content="✕" Width="26" Height="26" Background="#2B2D3C" Click="OnCloseClick" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Tab 切换内容 -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#8F92A8"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </TabControl.Resources>

                <!-- OCR 设置 -->
                <TabItem Header="文字识别 (OCR)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="OCR 服务提供方:" Margin="0,0,0,4"/>
                            <ComboBox x:Name="OcrProviderComboBox" Height="28" Margin="0,0,0,12" SelectionChanged="OnOcrProviderChanged"/>

                            <StackPanel x:Name="BaiduOcrSettingsPanel">
                                <TextBlock Text="百度 API Key:" Margin="0,0,0,4"/>
                                <TextBox x:Name="BaiduApiKeyTextBox" Margin="0,0,0,8"/>

                                <TextBlock Text="百度 Secret Key:" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="BaiduSecretKeyPasswordBox" Margin="0,0,0,12"/>

                                <TextBlock Text="💡 提示: 百度智能云通用文字识别提供每月免费调用额度，填入后即可享受高精识别；如未填将自动提示。" Foreground="#64687D" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 翻译引擎设置 -->
                <TabItem Header="翻译服务 (AI)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="翻译引擎:" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TransProviderComboBox" Height="28" Margin="0,0,0,12" SelectionChanged="OnTransProviderChanged"/>

                            <StackPanel x:Name="OpenAiSettingsPanel">
                                <TextBlock Text="API 端点 (Base URL):" Margin="0,0,0,4"/>
                                <TextBox x:Name="OpenAiBaseUrlTextBox" Margin="0,0,0,8"/>

                                <TextBlock Text="API 密钥 (API Key):" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="OpenAiApiKeyPasswordBox" Margin="0,0,0,8"/>

                                <TextBlock Text="模型名称 (Model):" Margin="0,0,0,4"/>
                                <TextBox x:Name="OpenAiModelTextBox" Margin="0,0,0,12"/>

                                <TextBlock Text="💡 兼容各大主流服务: 如 DeepSeek (https://api.deepseek.com/v1)、OpenAI、Moonshot 或本地 Ollama。" Foreground="#64687D" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 快捷键与桌面配置 -->
                <TabItem Header="快捷键与桌宠">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="全局截图翻译快捷键:" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="AltCheckBox" Content="Alt" IsChecked="True"/>
                                <CheckBox x:Name="CtrlCheckBox" Content="Ctrl"/>
                                <CheckBox x:Name="ShiftCheckBox" Content="Shift"/>
                                <CheckBox x:Name="WinCheckBox" Content="Win"/>
                                <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="HotkeyCharComboBox" Width="60" Height="26"/>
                            </StackPanel>

                            <Separator Background="#2B2D3C" Margin="0,6,0,12"/>

                            <TextBlock Text="桌宠选项:" Margin="0,0,0,6"/>
                            <CheckBox x:Name="TopMostCheckBox" Content="桌宠总在最前 (Topmost)" Margin="0,0,0,8"/>
                            <Button Content="🔄 重置桌宠位置到屏幕右下角" Click="OnResetPetPositionClick" Background="#2E3040" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 底部保存按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Click="OnCloseClick" Background="#2E3040" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="💾 保存配置" Click="OnSaveClick" Background="#536DFE" FontWeight="SemiBold" Padding="18,6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
