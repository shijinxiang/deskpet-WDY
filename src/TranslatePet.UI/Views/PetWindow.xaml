<Window x:Class="TranslatePet.UI.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="哆啦A梦" 
        Height="90" Width="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnPetMouseLeftButtonDown"
        MouseRightButtonUp="OnPetMouseRightButtonUp"
        MouseEnter="OnPetMouseEnter"
        MouseLeave="OnPetMouseLeave"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <!-- 微型桌宠轻缓悬浮与呼吸动效 -->
        <Storyboard x:Key="FloatStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-4.5" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowEllipse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.28" To="0.12" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.80" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="PetRoot" Cursor="Hand">
        <!-- 底部细腻接触阴影 -->
        <Ellipse x:Name="ShadowEllipse" Width="48" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Opacity="0.28">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="ShadowScale" CenterX="24" CenterY="4" ScaleX="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#60000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 迷你Q版哆啦A梦 (尺寸小巧精致，无任何文字) -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="80" Width="74" Margin="0,0,0,6">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PetTransform" Y="0"/>
                    <ScaleTransform x:Name="PetHoverScale" CenterX="37" CenterY="40" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="PetRotateTransform" CenterX="37" CenterY="40" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 逐帧动作显示画布 (Frame 0-3: 待机/眨眼/挥手；Frame 4-7: 掏铜锣烧抛吃进食) -->
            <Image x:Name="CharacterFrameImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#003550" Opacity="0.25"/>
                </Image.Effect>
            </Image>
        </Grid>

        <!-- 右键操作菜单 -->
        <Grid.ContextMenu>
            <ContextMenu Background="#1A2233" Foreground="#FFFFFF" BorderBrush="#0096D6" BorderThickness="1.5">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="🔍 截图翻译 (Alt+Q)" Click="OnMenuCaptureClick" FontWeight="Bold" Foreground="#00E5FF"/>
                <Separator Background="#2A354D"/>
                <MenuItem Header="⚙️ 参数设置" Click="OnMenuSettingsClick"/>
                <MenuItem Header="💤 隐藏桌宠 (托盘运行)" Click="OnMenuHideClick"/>
                <Separator Background="#2A354D"/>
                <MenuItem Header="🚪 退出程序" Click="OnMenuExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
