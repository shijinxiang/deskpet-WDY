<Window x:Class="TranslatePet.UI.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="哆啦A梦" 
        Height="150" Width="135"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnPetMouseLeftButtonDown"
        MouseRightButtonUp="OnPetMouseRightButtonUp"
        MouseEnter="OnPetMouseEnter"
        MouseLeave="OnPetMouseLeave"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <!-- 基础物理浮动与呼吸动画 -->
        <Storyboard x:Key="FloatStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-7" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowEllipse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.32" To="0.16" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.84" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="PetRoot" Cursor="Hand">
        <!-- 底部地面阴影 (随浮动缩放) -->
        <Ellipse x:Name="ShadowEllipse" Width="72" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.32">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="ShadowScale" CenterX="36" CenterY="7" ScaleX="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#70000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 哆啦A梦逐帧动画角色容器 (无任何文字/字体) -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="136" Width="125" Margin="0,0,0,10">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PetTransform" Y="0"/>
                    <ScaleTransform x:Name="PetHoverScale" CenterX="62.5" CenterY="68" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="PetRotateTransform" CenterX="62.5" CenterY="68" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 逐帧动作显示画布 (Frame 0: 待机 / Frame 1: 眨眼 / Frame 2: 开心 / Frame 3: 招手) -->
            <Image x:Name="CharacterFrameImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#004D73" Opacity="0.32"/>
                </Image.Effect>
            </Image>
        </Grid>

        <!-- 右键操作菜单 -->
        <Grid.ContextMenu>
            <ContextMenu Background="#1A2233" Foreground="#FFFFFF" BorderBrush="#0096D6" BorderThickness="1.5">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="🔍 截图翻译 (Alt+Q)" Click="OnMenuCaptureClick" FontWeight="Bold" Foreground="#00E5FF"/>
                <Separator Background="#2A354D"/>
                <MenuItem Header="⚙️ 参数设置" Click="OnMenuSettingsClick"/>
                <MenuItem Header="💤 隐藏桌宠 (托盘运行)" Click="OnMenuHideClick"/>
                <Separator Background="#2A354D"/>
                <MenuItem Header="🚪 退出程序" Click="OnMenuExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
