<Window x:Class="TranslatePet.UI.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranslatePet" 
        Height="110" Width="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnPetMouseLeftButtonDown"
        MouseRightButtonUp="OnPetMouseRightButtonUp"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <!-- 宠物流畅呼吸与浮动动画 -->
        <Storyboard x:Key="FloatStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetRoot"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                             From="0" To="-6" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 眨眼动画 -->
        <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEye" Storyboard.TargetProperty="Height">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="10"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="10"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="2"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.0" Value="10"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEye" Storyboard.TargetProperty="Height">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="10"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="10"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="2"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:4.0" Value="10"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="PetRoot" Cursor="Hand" ToolTip="点击或按快捷键唤起翻译，右键打开菜单">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform Y="0"/>
                <ScaleTransform x:Name="PetScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 柔和阴影 -->
        <Ellipse Width="64" Height="14" VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#50000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 桌宠身体 (软萌渐变水滴精灵) -->
        <Border Width="82" Height="82" CornerRadius="41" VerticalAlignment="Top" Margin="0,4,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop Color="#7C4DFF" Offset="0.0"/>
                    <GradientStop Color="#536DFE" Offset="0.5"/>
                    <GradientStop Color="#00E5FF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#536DFE" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <!-- 头顶发光翻译天线宝珠 -->
                <Ellipse Width="10" Height="10" Fill="#FFEA00" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="8" Color="#FFEA00" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 耳朵/触角装饰 -->
                <Path Data="M 22,20 C 16,12 24,6 30,14 Z" Fill="#7C4DFF" Opacity="0.85"/>
                <Path Data="M 60,20 C 66,12 58,6 52,14 Z" Fill="#7C4DFF" Opacity="0.85"/>

                <!-- 眼睛与表情容器 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0">
                    <!-- 左眼 -->
                    <Border x:Name="LeftEye" Width="8" Height="10" Background="#FFFFFF" CornerRadius="4" Margin="0,0,16,0">
                        <Ellipse Width="4" Height="4" Fill="#1E1E2F" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    </Border>
                    <!-- 右眼 -->
                    <Border x:Name="RightEye" Width="8" Height="10" Background="#FFFFFF" CornerRadius="4">
                        <Ellipse Width="4" Height="4" Fill="#1E1E2F" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"/>
                    </Border>
                </StackPanel>

                <!-- 腮红与小嘴 -->
                <Ellipse Width="8" Height="5" Fill="#FF80AB" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,14,0,0"/>
                <Ellipse Width="8" Height="5" Fill="#FF80AB" Opacity="0.75" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,14,0"/>

                <Path Data="M 37,48 Q 41,53 45,48" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- 右键菜单 -->
        <Grid.ContextMenu>
            <ContextMenu Background="#20222A" Foreground="#FFFFFF" BorderBrush="#353844" BorderThickness="1">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="🔍 截图翻译 (快捷键)" Click="OnMenuCaptureClick" FontWeight="SemiBold"/>
                <Separator Background="#353844"/>
                <MenuItem Header="⚙️ 参数设置" Click="OnMenuSettingsClick"/>
                <MenuItem Header="👁️ 隐藏桌宠 (托盘运行)" Click="OnMenuHideClick"/>
                <Separator Background="#353844"/>
                <MenuItem Header="🚪 退出程序" Click="OnMenuExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
