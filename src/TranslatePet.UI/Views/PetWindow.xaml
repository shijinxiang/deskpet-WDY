<Window x:Class="TranslatePet.UI.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="哆啦A梦 翻译桌宠" 
        Height="150" Width="135"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnPetMouseLeftButtonDown"
        MouseRightButtonUp="OnPetMouseRightButtonUp"
        MouseEnter="OnPetMouseEnter"
        MouseLeave="OnPetMouseLeave"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <!-- 哆啦A梦浮动/悬浮呼吸动画 -->
        <Storyboard x:Key="FloatStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PetTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-8" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowEllipse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.18" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShadowScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.82" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 翻译魔芋魔法星光闪烁动画 -->
        <Storyboard x:Key="SparkleStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="MagicSparkle1" Storyboard.TargetProperty="Opacity" From="0.2" To="1.0" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="MagicSparkle2" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="MagicSparkle3" Storyboard.TargetProperty="Opacity" From="0.3" To="0.95" Duration="0:0:1.1"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="PetRoot" Cursor="Hand" ToolTip="哆啦A梦：点击我或按 Alt+Q 翻译屏幕，右键打开菜单">
        <!-- 底部地面阴影 (随浮动缩放) -->
        <Ellipse x:Name="ShadowEllipse" Width="76" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.32">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="ShadowScale" CenterX="38" CenterY="7" ScaleX="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#70000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 哆啦A梦角色主体容器 -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="138" Width="125" Margin="0,0,0,12">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PetTransform" Y="0"/>
                    <ScaleTransform x:Name="PetHoverScale" CenterX="62.5" CenterY="69" ScaleX="1" ScaleY="1"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 哆啦A梦高清二次元形象 -->
            <Image x:Name="DoraemonImage"
                   Source="pack://application:,,,/Assets/doraemon.png"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#004D73" Opacity="0.35"/>
                </Image.Effect>
            </Image>

            <!-- 翻译魔芋魔法星光微光特效 -->
            <!-- 闪烁星光 1 (位于魔芋上方) -->
            <Path x:Name="MagicSparkle1"
                  Data="M 0,5 L 3,3 L 5,0 L 7,3 L 10,5 L 7,7 L 5,10 L 3,7 Z"
                  Fill="#FFEA00"
                  Width="11" Height="11"
                  Stretch="Fill"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,14,-6"
                  Opacity="0.8">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="6" Color="#FFEA00" Opacity="0.9" ShadowDepth="0"/>
                </Path.Effect>
            </Path>

            <!-- 闪烁星光 2 (位于魔芋左侧) -->
            <Path x:Name="MagicSparkle2"
                  Data="M 0,4 L 2.5,2.5 L 4,0 L 5.5,2.5 L 8,4 L 5.5,5.5 L 4,8 L 2.5,5.5 Z"
                  Fill="#00E5FF"
                  Width="9" Height="9"
                  Stretch="Fill"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,38,10"
                  Opacity="0.7">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="6" Color="#00E5FF" Opacity="0.8" ShadowDepth="0"/>
                </Path.Effect>
            </Path>

            <!-- 闪烁星光 3 (位于魔芋右下方) -->
            <Path x:Name="MagicSparkle3"
                  Data="M 0,3 L 2,2 L 3,0 L 4,2 L 6,3 L 4,4 L 3,6 L 2,4 Z"
                  Fill="#FFFFFF"
                  Width="7" Height="7"
                  Stretch="Fill"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,16,24"
                  Opacity="0.85">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="4" Color="#FFFFFF" Opacity="0.9" ShadowDepth="0"/>
                </Path.Effect>
            </Path>

            <!-- 互动小气泡 (鼠标悬浮时淡入) -->
            <Border x:Name="SpeechBubble"
                    Opacity="0"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    Padding="6,3"
                    BorderBrush="#0096D6"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-6,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <TextBlock Text="翻译魔芋！" FontSize="10" Foreground="#0077AA" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- 哆啦A梦特色右键菜单 -->
        <Grid.ContextMenu>
            <ContextMenu Background="#1A2233" Foreground="#FFFFFF" BorderBrush="#0096D6" BorderThickness="1.5">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="🍞 截图翻译 (Alt+Q)" Click="OnMenuCaptureClick" FontWeight="Bold" Foreground="#00E5FF"/>
                <Separator Background="#2A354D"/>
                <MenuItem Header="⚙️ 参数设置" Click="OnMenuSettingsClick"/>
                <MenuItem Header="💤 隐藏桌宠 (托盘运行)" Click="OnMenuHideClick"/>
                <Separator Background="#2A354D"/>
                <MenuItem Header="🚪 退出程序" Click="OnMenuExitClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
